{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "cd apps/web && npx next build",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/funnels/process",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/agenda/process",
      "schedule": "0 12 * * *"
    }
  ]
}
